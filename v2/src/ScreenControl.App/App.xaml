<?xml version="1.0" encoding="utf-8"?>
<!--
  ApplicationDefinition。
  作用：
    1) 让 XAML 编译器生成 App.xaml.g.h（内含 AppT<App> 基类）与
       XamlMetaDataProvider（页面类型注册表，MainWindow.xaml 的
       InitializeComponent 在运行时要靠它解析类型）。
    2) 提供 XamlControlsResources（WinUI 控件样式），否则控件无法实例化。
    3) 提供全局共用的卡片 / 文本样式（官方做法：可复用样式集中在
       Application.Resources，页面用 {StaticResource} 引用）。
-->
<Application
    x:Class="ScreenControl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ 卡片 ============ -->
            <!-- 普通卡片：四边内边距 16 -->
            <Style x:Key="PageCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <!-- 单行卡片：上下不留内边距，最小高度 64（与折叠卡标题行同高） -->
            <Style x:Key="SettingsRowCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,0,16,0" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <!-- 折叠卡（Expander）：纵向内边距收掉，保证与单行卡片等高 -->
            <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,0,16,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!-- ============ 文本 ============ -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,24,0,0" />
            </Style>

            <!-- ============ 设置行 ============ -->
            <!-- 图标列固定 20 宽并居中：不同字形宽度不同，固定列宽才能让各行文字起点对齐 -->
            <Style x:Key="SettingRowIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 行内间距统一由父 Grid 的 ColumnSpacing 提供（官方 SettingsCard 范式） -->
            <Style x:Key="SettingRowTitleStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingRowSmallTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.6" />
            </Style>

            <Style x:Key="SettingRowStatusStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingRowValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 只用开关本体：清空来内容，尺寸交给默认模板（MinWidth 0 才会缩到贴合本体） -->
            <Style x:Key="SettingRowToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 展开内容：左侧缩进对齐标题文字，上下留白对称 -->
            <Style x:Key="ExpanderBodyHostStyle" TargetType="Grid">
                <Setter Property="Margin" Value="32,8,0,16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
