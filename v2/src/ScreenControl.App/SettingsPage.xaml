<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenControl.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设置页：静态布局全部声明在这里，C++ 只负责事件与数据填充。 -->
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        HorizontalContentAlignment="Stretch">

        <ScrollViewer.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </ScrollViewer.Transitions>

        <StackPanel Spacing="8" Margin="24,8,24,24">

            <!-- 折叠展开/收起时，下方控件用官方 RepositionThemeTransition 平滑推开 -->
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />

            <!-- ==================== 应用行为 ==================== -->
            <TextBlock Text="应用行为" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingsRowCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingRowIconStyle}" />
                    <TextBlock Grid.Column="1" Text="开机自启动" Style="{StaticResource SettingRowTitleStyle}" />
                    <TextBlock x:Name="AutoStartStatus" Grid.Column="2" Text="关" Style="{StaticResource SettingRowStatusStyle}" />
                    <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="3" Style="{StaticResource SettingRowToggleStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE8BB;" Style="{StaticResource SettingRowIconStyle}" />
                    <TextBlock Grid.Column="1" Text="关闭窗口时" Style="{StaticResource SettingRowTitleStyle}" />
                    <ComboBox
                        x:Name="CloseChoice"
                        Grid.Column="2"
                        VerticalAlignment="Center">
                        <x:String>隐藏到系统托盘</x:String>
                        <x:String>退出程序</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ==================== 个性化 ==================== -->
            <TextBlock Text="个性化" Style="{StaticResource SectionTitleStyle}" />

            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE706;" Style="{StaticResource SettingRowIconStyle}" />
                        <TextBlock Grid.Column="1" Text="应用主题" Style="{StaticResource SettingRowTitleStyle}" />
                        <TextBlock x:Name="ThemeValue" Grid.Column="2" Text="使用系统设置" Style="{StaticResource SettingRowValueStyle}" />
                    </Grid>
                </Expander.Header>

                <RadioButtons x:Name="ThemeChoice" Margin="32,8,0,16">
                    <x:String>浅色</x:String>
                    <x:String>深色</x:String>
                    <x:String>使用系统设置</x:String>
                </RadioButtons>
            </Expander>

            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingRowIconStyle}" />
                        <TextBlock Grid.Column="1" Text="主题色" Style="{StaticResource SettingRowTitleStyle}" />
                        <TextBlock x:Name="ThemeColorValue" Grid.Column="2" Text="使用系统设置" Style="{StaticResource SettingRowValueStyle}" />
                    </Grid>
                </Expander.Header>

                <RadioButtons x:Name="ThemeColorChoice" Margin="32,8,0,16">
                    <x:String>TUF GAMING</x:String>
                    <x:String>使用系统设置</x:String>
                </RadioButtons>
            </Expander>

            <!-- ==================== 屏幕设置 ==================== -->
            <TextBlock Text="屏幕设置" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingsRowCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE708;" Style="{StaticResource SettingRowIconStyle}" />

                    <StackPanel Grid.Column="1" Spacing="2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="睡眠模式" />
                        <TextBlock Text="无内容播放时关闭屏幕" Style="{StaticResource SettingRowSmallTextStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="SleepStatus" Grid.Column="2" Text="开" Style="{StaticResource SettingRowStatusStyle}" />
                    <ToggleSwitch x:Name="SleepToggle" Grid.Column="3" Style="{StaticResource SettingRowToggleStyle}" />
                </Grid>
            </Border>

            <!-- ==================== 更新 ==================== -->
            <TextBlock Text="更新" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingsRowCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingRowIconStyle}" />

                    <StackPanel Grid.Column="1" Spacing="2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="自动检测更新" />
                        <TextBlock x:Name="UpdateDesc" Text="固件版本" Style="{StaticResource SettingRowSmallTextStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="UpdateStatus" Grid.Column="2" Text="开" Style="{StaticResource SettingRowStatusStyle}" />
                    <ToggleSwitch x:Name="UpdateToggle" Grid.Column="3" Style="{StaticResource SettingRowToggleStyle}" />
                </Grid>
            </Border>

            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE823;" Style="{StaticResource SettingRowIconStyle}" />
                        <TextBlock Grid.Column="1" Text="检查频率" Style="{StaticResource SettingRowTitleStyle}" />
                        <TextBlock x:Name="FreqValue" Grid.Column="2" Text="每次启动" Style="{StaticResource SettingRowValueStyle}" />
                    </Grid>
                </Expander.Header>

                <StackPanel Margin="32,8,0,16" Spacing="12">
                    <ComboBox x:Name="FreqBox">
                        <x:String>每次启动</x:String>
                        <x:String>每天</x:String>
                        <x:String>每周</x:String>
                        <x:String>每月</x:String>
                        <x:String>每半年</x:String>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CheckNowButton" Content="立即检查" />
                        <ProgressRing
                            x:Name="CheckRing"
                            Width="24"
                            Height="24"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <InfoBar
                x:Name="ResultBar"
                IsOpen="False"
                IsClosable="True"
                Title="检查更新" />

        </StackPanel>
    </ScrollViewer>
</Page>
