<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TufScreenControl.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主控页：静态布局全部声明在这里，C++ 只负责事件与数据填充。 -->
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        HorizontalContentAlignment="Stretch">

        <!-- 入场动画：元素进入可视树时自动播放"淡入 + 从底部上浮" -->
        <ScrollViewer.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </ScrollViewer.Transitions>

        <StackPanel Spacing="16" Margin="24,8,24,24">

            <TextBlock
                x:Uid="DisplayPageTitle"
                Text="主控"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,12" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：预览框（设备屏幕是 1:1 的 320x320） -->
                <Border
                    Width="332"
                    Height="332"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    Background="Black"
                    Translation="0,0,16">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid>
                        <!-- 画面：外层圆角 8 的 Border 负责裁剪，与外框完全重合 -->
                        <Border CornerRadius="8">
                            <Image
                                x:Name="PreviewImage"
                                Stretch="Uniform"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="设备屏幕预览" />
                        </Border>

                        <TextBlock
                            x:Name="PreviewPlaceholder"
                            x:Uid="PreviewPlaceholder"
                            Text="未在显示"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextFillColorTertiaryBrush}" />

                        <!-- 设备连接状态徽标：叠在预览框左上角 -->
                        <Border
                            CornerRadius="4"
                            Background="#99000000"
                            Padding="8,4,8,4"
                            Margin="8,8,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <TextBlock
                                x:Name="DeviceText"
                                Text="设备：未连接"
                                FontSize="12"
                                Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧：控制卡 -->
                <Border
                    Grid.Column="1"
                    CornerRadius="4"
                    Padding="16"
                    BorderThickness="1"
                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                    Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">

                        <ToggleSwitch x:Name="ScreenSwitch" x:Uid="ScreenSwitch" Header="屏幕开关" />

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="BrightnessLabel" Text="亮度" />
                            <Slider
                                x:Name="BrightnessSlider"
                                Minimum="0"
                                Maximum="100"
                                AutomationProperties.Name="亮度" />
                        </StackPanel>

                        <ComboBox x:Name="FitModeBox" x:Uid="FitModeBox" Header="图像适应">
                            <x:String>适应</x:String>
                            <x:String>填充</x:String>
                            <x:String>拉伸</x:String>
                        </ComboBox>

                        <ComboBox x:Name="RotationBox" x:Uid="RotationBox" Header="画面旋转">
                            <x:String>0°</x:String>
                            <x:String>90°</x:String>
                            <x:String>180°</x:String>
                            <x:String>270°</x:String>
                        </ComboBox>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- 素材与播放 -->
            <Border
                CornerRadius="4"
                Padding="16"
                BorderThickness="1"
                BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">

                    <TextBlock
                        x:Name="StatusText"
                        Text="未在显示"
                        FontSize="12" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="PhotoLabel" Text="照片" />
                            <ListView x:Name="PhotoList" Height="180" AutomationProperties.Name="照片素材列表" />
                            <Button x:Name="PlayPhotoButton" x:Uid="PlayPhotoButton" Content="播放选中的照片" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Uid="VideoLabel" Text="视频" />
                            <ListView x:Name="VideoList" Height="180" AutomationProperties.Name="视频素材列表" />
                            <Button x:Name="PlayVideoButton" x:Uid="PlayVideoButton" Content="播放选中的视频" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="StopButton" x:Uid="StopButton" Content="停止显示" />

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
