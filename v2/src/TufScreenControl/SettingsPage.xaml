<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TufScreenControl.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设置页：静态布局全部声明在这里，C++ 只负责事件与数据填充。 -->
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        HorizontalContentAlignment="Stretch">

        <ScrollViewer.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </ScrollViewer.Transitions>

        <!--
            分组结构（关键）：
            根 StackPanel 的每个子元素 = 一个「分组整体」（标题 + 若干卡片）。

            动画全部使用框架内置的主题过渡，没有任何自写动画、也没有自定义时长：
              · ScrollViewer.Transitions 里的 EntranceThemeTransition：页面首次进入时的入场动画；
              · StackPanel.ChildrenTransitions 里的 RepositionThemeTransition：兄弟元素因为
                布局变化而位移时，由框架负责补间。
            Expander 内置的展开/收起动画只作用于它自己的内容（对内容做位移 + 切
            Visibility），不会补间外层布局的高度变化；因此展开/收起时下方分组的位移，
            要由 ChildrenTransitions 里的 RepositionThemeTransition 来表现。
        -->
        <StackPanel Margin="24,8,24,24" Spacing="0">

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock x:Uid="SettingsPageTitle" Text="设置" Style="{StaticResource PageTitleStyle}" />

            <!-- ==================== 应用行为 ==================== -->
            <StackPanel Spacing="4">

                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock x:Uid="SectionBehavior" Text="应用行为" Style="{StaticResource SectionTitleStyle}" />

                <Border Style="{StaticResource SettingsRowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingRowIconStyle}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" x:Uid="AutoStartLabel" Text="开机自启动" Style="{StaticResource SettingRowTitleStyle}" />
                        <TextBlock x:Name="AutoStartStatus" Grid.Column="2" Text="关" Style="{StaticResource SettingRowStatusStyle}" />
                        <ToggleSwitch
                            x:Name="AutoStartSwitch"
                            Grid.Column="3"
                            AutomationProperties.Name="开机自启动"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8BB;" Style="{StaticResource SettingRowIconStyle}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" x:Uid="CloseActionLabel" Text="关闭窗口时" Style="{StaticResource SettingRowTitleStyle}" />
                        <ComboBox x:Name="CloseChoice" Grid.Column="2" MinWidth="200" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="关闭窗口时">
                            <x:String>隐藏到系统托盘</x:String>
                            <x:String>退出程序</x:String>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== 个性化 ==================== -->
            <StackPanel Spacing="4">

                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock x:Uid="SectionPersonalization" Text="个性化" Style="{StaticResource SectionTitleStyle}" />

                <Expander Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE706;" Style="{StaticResource SettingRowIconStyle}" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" x:Uid="ThemeLabel" Text="应用主题" Style="{StaticResource SettingRowTitleStyle}" />
                            <TextBlock x:Name="ThemeValue" Grid.Column="2" Text="使用系统设置" Style="{StaticResource SettingRowValueStyle}" />
                        </Grid>
                    </Expander.Header>

                    <RadioButtons x:Name="ThemeChoice" Margin="32,8,0,16" AutomationProperties.Name="应用主题">
                        <x:String>浅色</x:String>
                        <x:String>深色</x:String>
                        <x:String>使用系统设置</x:String>
                    </RadioButtons>
                </Expander>

                <Expander Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingRowIconStyle}" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" x:Uid="ThemeColorLabel" Text="主题色" Style="{StaticResource SettingRowTitleStyle}" />
                            <TextBlock x:Name="ThemeColorValue" Grid.Column="2" Text="使用系统设置" Style="{StaticResource SettingRowValueStyle}" />
                        </Grid>
                    </Expander.Header>

                    <RadioButtons x:Name="ThemeColorChoice" Margin="32,8,0,16" AutomationProperties.Name="主题色">
                        <x:String>TUF GAMING</x:String>
                        <x:String>使用系统设置</x:String>
                    </RadioButtons>
                </Expander>
            </StackPanel>

            <!-- ==================== 屏幕设置 ==================== -->
            <StackPanel Spacing="4">

                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock x:Uid="SectionDisplay" Text="屏幕设置" Style="{StaticResource SectionTitleStyle}" />

                <Border Style="{StaticResource SettingsRowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE708;" Style="{StaticResource SettingRowIconStyle}" AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="SleepLabel" Text="睡眠模式" />
                            <TextBlock x:Uid="SleepDescription" Text="无内容播放时关闭屏幕" Style="{StaticResource SettingRowSmallTextStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="SleepStatus" Grid.Column="2" Text="开" Style="{StaticResource SettingRowStatusStyle}" />
                        <ToggleSwitch
                            x:Name="SleepToggle"
                            Grid.Column="3"
                            AutomationProperties.Name="睡眠模式"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== 更新 ==================== -->
            <StackPanel Spacing="4">

                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock x:Uid="SectionUpdate" Text="更新" Style="{StaticResource SectionTitleStyle}" />

                <Border Style="{StaticResource SettingsRowCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingRowIconStyle}" AutomationProperties.AccessibilityView="Raw" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="UpdateLabel" Text="自动检测更新" />
                            <TextBlock x:Name="UpdateDesc" Text="固件版本" Style="{StaticResource SettingRowSmallTextStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="UpdateStatus" Grid.Column="2" Text="开" Style="{StaticResource SettingRowStatusStyle}" />
                        <ToggleSwitch
                            x:Name="UpdateToggle"
                            Grid.Column="3"
                            AutomationProperties.Name="自动检测更新"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Expander Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE823;" Style="{StaticResource SettingRowIconStyle}" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" x:Uid="UpdateFrequencyLabel" Text="检查频率" Style="{StaticResource SettingRowTitleStyle}" />
                            <TextBlock x:Name="FreqValue" Grid.Column="2" Text="每次启动" Style="{StaticResource SettingRowValueStyle}" />
                        </Grid>
                    </Expander.Header>

                    <StackPanel Margin="32,8,0,16" Spacing="12">
                        <ComboBox x:Name="FreqBox" MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="检查频率">
                            <x:String>每次启动</x:String>
                            <x:String>每天</x:String>
                            <x:String>每周</x:String>
                            <x:String>每月</x:String>
                            <x:String>每半年</x:String>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CheckNowButton" x:Uid="CheckNowButton" Content="立即检查" />
                            <ProgressRing
                                x:Name="CheckRing"
                                Width="24"
                                Height="24"
                                IsActive="False"
                                Visibility="Collapsed"
                                AutomationProperties.Name="正在检查更新" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <InfoBar
                    x:Name="ResultBar"
                    IsOpen="False"
                    IsClosable="True"
                    x:Uid="ResultBar"
                    Title="检查更新" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
