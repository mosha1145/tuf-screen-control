<?xml version="1.0" encoding="utf-8"?>
<!--
  主窗口（x:Class="TufScreenControl.MainWindow"）。
  声明式布局：自定义标题栏 + NavigationView + 页面 Frame。
  C++ 只负责事件、导航与业务逻辑（见 MainWindow.xaml.cpp）。
  根容器背景留空，避免盖住 Mica 系统背衬。
-->
<Window
    x:Class="TufScreenControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TUF Screen Control">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：占第一行，作为拖动区（ExtendsContentIntoTitleBar + SetTitleBar） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44">
            <StackPanel
                Orientation="Horizontal"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon Glyph="&#xE7F4;" FontSize="15" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    x:Uid="AppTitleText"
                    Text="TUF Screen Control"
                    FontSize="13"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 主区域：NavigationView 只占第 1 行，避免折叠面板与自定义标题栏重叠 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="641"
            ExpandedModeThresholdWidth="1008"
            OpenPaneLength="216">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DisplayNavItem" x:Uid="NavDisplayItem" Content="主控" Tag="display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="SettingsNavItem" x:Uid="NavSettingsItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

    </Grid>
</Window>
